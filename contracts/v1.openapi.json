{
  "openapi": "3.1.0",
  "info": {
    "title": "TrendPilot frozen contract",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8317"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Health and configuration presence; never secrets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "post": {
        "operationId": "createRun",
        "description": "profile_json is a JSON string satisfying Profile. File pair optional, but never accept just one file. Idempotency-Key is required.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "profile_json"
                ],
                "properties": {
                  "profile_json": {
                    "type": "string"
                  },
                  "old_export": {
                    "type": "string",
                    "format": "binary"
                  },
                  "current_export": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued; save access_token only in memory/sessionStorage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "getRun",
        "security": [
          {
            "RunToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Poll every 1500ms until terminal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/artifacts/report.md": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "downloadReport",
        "security": [
          {
            "RunToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Generated Markdown; no raw ZIP or absolute host paths",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/publish": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "post": {
        "operationId": "publishReport",
        "security": [
          {
            "RunToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Publication state, not automatic public success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publication"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/p/{public_token}": {
      "get": {
        "operationId": "publicReport",
        "parameters": [
          {
            "in": "path",
            "name": "public_token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 32
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sanitized read-only HTML; generated from public allowlist, never raw result JSON",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/runs/{run_id}/artifacts/{artifact_name}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "in": "path",
          "name": "artifact_name",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      ],
      "get": {
        "operationId": "downloadArtifact",
        "security": [
          {
            "RunToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Generated production artifact; Content-Disposition attachment",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RunToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Unpredictable per-run read token, not a sponsor API key"
      }
    },
    "parameters": {
      "RunId": {
        "in": "path",
        "name": "run_id",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Structured failure; see HTTP.md status mapping",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "niche",
          "audience",
          "goal",
          "format",
          "weekly_minutes",
          "query",
          "data_mode",
          "sample_followers",
          "pair_is_consecutive",
          "cloud_processing_consent"
        ],
        "properties": {
          "niche": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "audience": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "goal": {
            "enum": [
              "views",
              "followers",
              "leads"
            ]
          },
          "format": {
            "enum": [
              "instagram_reel",
              "youtube_short"
            ]
          },
          "weekly_minutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 1200
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "data_mode": {
            "enum": [
              "demo",
              "live"
            ]
          },
          "sample_followers": {
            "type": "boolean"
          },
          "pair_is_consecutive": {
            "type": "boolean"
          },
          "cloud_processing_consent": {
            "type": "boolean"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "ok",
          "configured"
        ],
        "properties": {
          "contract_version": {
            "const": "1.1.0"
          },
          "ok": {
            "type": "boolean"
          },
          "configured": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nosana",
              "daytona",
              "dnsimple",
              "youtube"
            ],
            "properties": {
              "nosana": {
                "type": "boolean"
              },
              "daytona": {
                "type": "boolean"
              },
              "dnsimple": {
                "type": "boolean"
              },
              "youtube": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "run_id",
          "access_token",
          "status"
        ],
        "properties": {
          "contract_version": {
            "const": "1.1.0"
          },
          "run_id": {
            "type": "string"
          },
          "access_token": {
            "type": "string",
            "minLength": 32
          },
          "status": {
            "const": "queued"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "error"
        ],
        "properties": {
          "contract_version": {
            "const": "1.1.0"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "Trace": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "operation",
          "mode",
          "status",
          "remote_id",
          "executed_at",
          "duration_ms",
          "artifact_sha256",
          "detail"
        ],
        "properties": {
          "provider": {
            "enum": [
              "nosana",
              "daytona",
              "dnsimple",
              "youtube"
            ]
          },
          "operation": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "live",
              "mock",
              "cached"
            ]
          },
          "status": {
            "enum": [
              "success",
              "failed",
              "skipped"
            ]
          },
          "remote_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "executed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "artifact_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "source_mode",
          "url",
          "title",
          "published_at",
          "observed_at",
          "views",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "platform": {
            "enum": [
              "youtube",
              "instagram",
              "manual",
              "synthetic"
            ]
          },
          "source_mode": {
            "enum": [
              "live",
              "cached",
              "synthetic",
              "manual"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "views": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Opportunity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source_ids",
          "reason",
          "mean_views_per_hour",
          "momentum_evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "mean_views_per_hour": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "momentum_evidence": {
            "enum": [
              "single_observation",
              "measured_growth",
              "measured_acceleration",
              "insufficient"
            ]
          }
        }
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "old_username",
          "new_username",
          "status",
          "method",
          "checked_at",
          "access_context",
          "evidence",
          "active_evidence",
          "relationship_absent"
        ],
        "properties": {
          "old_username": {
            "type": "string"
          },
          "new_username": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "confirmed_rename_still_current_follower",
              "confirmed_rename_relationship_absent",
              "checked_no_confirmed_rename",
              "username_change_not_ruled_out"
            ]
          },
          "method": {
            "enum": [
              "export_continuity",
              "public_manual",
              "stable_account_id",
              "unresolved",
              "synthetic_fixture"
            ]
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "access_context": {
            "enum": [
              "offline_exports",
              "non_login_public",
              "synthetic_fixture"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relationship_absent": {
            "type": "boolean"
          }
        }
      },
      "Followers": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_kind",
          "old_count",
          "current_count",
          "export_count_delta",
          "retained_count",
          "raw_missing_count",
          "raw_new_count",
          "outside_window_count",
          "renamed_still_following_count",
          "relationship_absent_count",
          "unresolved_count",
          "explicitly_inactive_count",
          "new_observed_excluding_renames",
          "audits",
          "scope_note"
        ],
        "properties": {
          "input_kind": {
            "enum": [
              "synthetic",
              "user_upload"
            ]
          },
          "old_count": {
            "type": "integer",
            "minimum": 0
          },
          "current_count": {
            "type": "integer",
            "minimum": 0
          },
          "export_count_delta": {
            "type": "integer"
          },
          "retained_count": {
            "type": "integer",
            "minimum": 0
          },
          "raw_missing_count": {
            "type": "integer",
            "minimum": 0
          },
          "raw_new_count": {
            "type": "integer",
            "minimum": 0
          },
          "outside_window_count": {
            "type": "integer",
            "minimum": 0
          },
          "renamed_still_following_count": {
            "type": "integer",
            "minimum": 0
          },
          "relationship_absent_count": {
            "type": "integer",
            "minimum": 0
          },
          "unresolved_count": {
            "type": "integer",
            "minimum": 0
          },
          "explicitly_inactive_count": {
            "type": "integer",
            "minimum": 0
          },
          "new_observed_excluding_renames": {
            "type": "integer",
            "minimum": 0
          },
          "audits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "scope_note": {
            "type": "string"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "strategy_mode",
          "weakness_target",
          "title",
          "source_ids",
          "fit_reason",
          "hook_a",
          "hook_b",
          "outline",
          "caption",
          "production_minutes",
          "cta",
          "monetization_hypothesis",
          "metric",
          "baseline",
          "measurement_window_hours",
          "success_rule",
          "production_package"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "strategy_mode": {
            "enum": [
              "safe_bet",
              "growth_experiment"
            ]
          },
          "weakness_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fit_reason": {
            "type": "string"
          },
          "hook_a": {
            "type": "string"
          },
          "hook_b": {
            "type": "string"
          },
          "outline": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "caption": {
            "type": "string"
          },
          "production_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          },
          "cta": {
            "type": "string"
          },
          "monetization_hypothesis": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "baseline": {
            "type": [
              "number",
              "null"
            ]
          },
          "measurement_window_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          },
          "success_rule": {
            "type": "string"
          },
          "production_package": {
            "$ref": "#/components/schemas/ProductionPackage"
          }
        }
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "enum": [
              "report.md",
              "content-strategy.json",
              "script.md",
              "shot-list.json",
              "editing-guide.md",
              "thumbnail-plan.md",
              "publishing-package.md"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      },
      "Result": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_mode",
          "sample_notice",
          "sources",
          "opportunities",
          "followers",
          "actions",
          "limitations",
          "artifacts"
        ],
        "properties": {
          "evidence_mode": {
            "enum": [
              "live",
              "cached",
              "synthetic",
              "mixed"
            ]
          },
          "sample_notice": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "opportunities": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            }
          },
          "followers": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Followers"
              },
              {
                "type": "null"
              }
            ]
          },
          "actions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "run_id",
          "status",
          "stage",
          "is_mock",
          "created_at",
          "updated_at",
          "trace",
          "result",
          "error"
        ],
        "properties": {
          "contract_version": {
            "const": "1.1.0"
          },
          "run_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "partial",
              "failed"
            ]
          },
          "stage": {
            "enum": [
              "validate",
              "plan",
              "analyze",
              "recommend",
              "render",
              "done"
            ]
          },
          "is_mock": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "trace": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trace"
            }
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Result"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PublishRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment",
          "publish_consent"
        ],
        "properties": {
          "environment": {
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "publish_consent": {
            "const": true
          }
        }
      },
      "Publication": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environment",
          "status",
          "record_id",
          "public_url",
          "fallback_url",
          "note"
        ],
        "properties": {
          "environment": {
            "enum": [
              "sandbox",
              "production"
            ]
          },
          "status": {
            "enum": [
              "sandbox_record_created",
              "dns_pending",
              "published",
              "not_configured",
              "failed"
            ]
          },
          "record_id": {
            "type": [
              "string",
